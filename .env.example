# Fish Audio TTS — fish.audio 대시보드에서 발급
FISH_AUDIO_API_KEY=

# mission-control(../../mission-control, 통합 모니터링 대시보드) 이슈 수집 API —
# lib/mission_control_log.py가 사용. 로컬에 mission-control을 안 띄워둔
# 세션이 대부분이라 비워두면(둘 중 하나라도 없으면) 조용히 보고를 건너뛴다,
# 필수 아님. URL 예: http://localhost:3011 또는 배포 URL.
MISSION_CONTROL_INGEST_URL=
MISSION_CONTROL_INGEST_SECRET=

# lib/mission_control_sync.py(캡션 동기화)용 — 이 프로젝트 자체 Supabase가
# 없어 health-shorts의 값을 그대로 공유한다(mission_control 스키마
# hs_platform_captions 테이블, project 컬럼으로 프로젝트별 구분). 값은
# health-shorts/.env에서 복사.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
